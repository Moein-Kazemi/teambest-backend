{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend (Express)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "debug"],
      "port": 9229,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/**/*.js", "${workspaceFolder}/**/*.ts"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
